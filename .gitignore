# 1. Inside your project root, initialize Git
git init

# 2. Verify or create your .gitignore
cat << 'EOF' > .gitignore
# -----------------------------
# Environments & Secrets
# -----------------------------
.env
.env.*
!.env.example

# -----------------------------
# Backend (Python / FastAPI)
# -----------------------------
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/
.pytest_cache/
alembic/versions/*
!alembic/versions/.keep
backend/storage/uploads/*
!backend/storage/uploads/.keep

# -----------------------------
# Frontend (Node / React)
# -----------------------------
frontend/node_modules/
frontend/dist/
frontend/build/
npm-debug.log
yarn-error.log

# -----------------------------
# OS & Editor Files
# -----------------------------
.DS_Store
.vscode/
.idea/
*.swp
EOF