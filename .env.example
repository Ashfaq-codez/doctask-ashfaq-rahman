# doctask-ashfaq-rahman/.env.example

# Environment
ENVIRONMENT=development

# Database Configuration
# We use asyncpg for high-performance asynchronous PostgreSQL connections
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/superdocs_agent

# AI Provider Keys
OPENAI_API_KEY=your_openai_api_key_here

# Redis (for task queues and Celery)
REDIS_URL=redis://localhost:6379/0